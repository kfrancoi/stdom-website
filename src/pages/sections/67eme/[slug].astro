---
import SectionPage, { type Theme } from '../../../components/SectionPage.astro';
import { getSections67 } from '../../../lib/content';

export async function getStaticPaths() {
  const sections67 = await getSections67();
  return sections67.map((section) => ({
    params: { slug: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;

const theme: Theme = {
  unitLabel: '67ème Unité Guide',
  breadcrumbLabel: '67ème Guide',
  sectionsHref: '/sections#67eme',
  backLabel: 'Toutes les sections guides',
  heroBg: 'bg-gradient-to-br from-guide-purple to-guide-green',
  heroOverlay: 'bg-gradient-to-r from-guide-purple/90 to-guide-green/70',
  leaderLabel: 'Cheftaine',
  teamLabel: "L'équipe d'animatrices",
  staffNoun: 'animatrices',
  barLeader: 'bg-guide-purple',
  barTeam: 'bg-guide-green',
  ctaBox: 'bg-gradient-to-br from-guide-purple to-guide-green',
  ctaText: 'text-white/80',
  ctaButton: 'text-guide-purple',
  ctaPhrase: `Votre fille a ${section.ageRange.replace('–', 'à')} ? Contactez-nous pour l'inscrire dans cette section !`,
  inscriptionEmail: 'inscriptions67@stdom.be',
};
---

<SectionPage section={section} theme={theme} />
