---
import SectionPage, { type Theme } from '../../../components/SectionPage.astro';
import { getSections106 } from '../../../lib/content';

export async function getStaticPaths() {
  const sections106 = await getSections106();
  return sections106.map((section) => ({
    params: { slug: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;

// Fond du hero selon la branche
const heroBgParType: Record<string, string> = {
  baladins: 'bg-gradient-to-br from-amber-700 to-amber-500',
  louveteaux: 'bg-gradient-to-br from-gray-800 to-gray-600',
  eclaireurs: 'bg-gradient-to-br from-gray-900 to-gray-700',
  pionniers: 'bg-gradient-to-br from-unit-dark to-gray-700',
};

const theme: Theme = {
  unitLabel: '106ème Unité Scoute',
  breadcrumbLabel: '106ème Scout',
  sectionsHref: '/sections#106eme',
  backLabel: 'Toutes les sections scouts',
  heroBg: heroBgParType[section.type] ?? heroBgParType.louveteaux,
  heroOverlay: 'bg-gradient-to-r from-black/70 to-black/30',
  leaderLabel: 'Grand chef',
  teamLabel: "L'équipe d'animateurs",
  staffNoun: 'animateurs',
  barLeader: 'bg-unit-dark',
  barTeam: 'bg-accent',
  ctaBox: 'bg-unit-dark',
  ctaText: 'text-gray-300',
  ctaButton: 'text-unit-dark',
  ctaPhrase: `Votre enfant a ${section.ageRange.replace('–', 'à')} ? Contactez-nous pour l'inscrire !`,
  inscriptionEmail: 'inscriptions106@stdom.be',
};
---

<SectionPage section={section} theme={theme} />
