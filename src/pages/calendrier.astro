---
import PageLayout from '../components/PageLayout.astro';
import { getEvents, categoryConfig, type CalendarEvent } from '../lib/content';

const events = await getEvents();

// Group events by month
const months: Record<string, CalendarEvent[]> = {};
events.forEach((e) => {
  const ym = e.date.substring(0, 7); // YYYY-MM
  if (!months[ym]) months[ym] = [];
  months[ym].push(e);
});

const sortedMonths = Object.keys(months).sort();

function monthLabel(ym: string): string {
  const [year, month] = ym.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1, 1);
  return date.toLocaleDateString('fr-BE', { month: 'long', year: 'numeric' });
}

function formatDay(dateStr: string): string {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('fr-BE', { weekday: 'long', day: 'numeric', month: 'long' });
}

function formatRange(start: string, end?: string): string {
  if (!end) return formatDay(start);
  const s = new Date(start + 'T12:00:00');
  const e = new Date(end + 'T12:00:00');
  if (s.getMonth() === e.getMonth()) {
    return `Du ${s.getDate()} au ${e.getDate()} ${e.toLocaleDateString('fr-BE', { month: 'long', year: 'numeric' })}`;
  }
  return `Du ${s.toLocaleDateString('fr-BE', { day: 'numeric', month: 'long' })} au ${e.toLocaleDateString('fr-BE', { day: 'numeric', month: 'long', year: 'numeric' })}`;
}

const unitLabel: Record<string, string> = {
  '67': '67ème Guide uniquement',
  '106': '106ème Scout uniquement',
  'both': '67ème & 106ème',
};

const today = new Date().toISOString().split('T')[0];

// Année scoute : elle démarre en septembre (2026–2027 à partir de sept. 2026)
const now = new Date();
const scoutYearStart = now.getMonth() >= 8 ? now.getFullYear() : now.getFullYear() - 1;
const scoutYear = `${scoutYearStart}–${scoutYearStart + 1}`;

const categories = Object.entries(categoryConfig);
---

<PageLayout
  title="Calendrier"
  description={`Calendrier complet de l'année scoute ${scoutYear} de l'unité Saint-Dominique — réunions, week-ends, camps et événements.`}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-unit-dark to-gray-800 py-16 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-unit-gold font-semibold text-sm uppercase tracking-wider mb-2">Année scoute {scoutYear}</p>
      <h1 class="text-4xl font-bold mb-3">Calendrier</h1>
      <p class="text-gray-300 max-w-xl">
        Toutes les dates importantes de l'unité Saint-Dominique. Marquez les dans votre agenda !
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid lg:grid-cols-4 gap-10">

      <!-- Légende (sidebar) -->
      <aside class="lg:col-span-1">
        <div class="sticky top-20">
          <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-4">Légende</h2>
          <ul class="space-y-2">
            {categories.map(([key, config]) => (
              <li class="flex items-center gap-2 text-sm text-gray-700">
                <span class={`w-3 h-3 rounded-full shrink-0 ${config.bg}`}></span>
                {config.label}
              </li>
            ))}
          </ul>

          {sortedMonths.length > 0 && (
            <div class="mt-8">
              <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-4">Navigation</h2>
              <ul class="space-y-1">
                {sortedMonths.map((ym) => (
                  <li>
                    <a
                      href={`#month-${ym}`}
                      class="text-sm text-gray-600 hover:text-unit-red capitalize transition-colors"
                    >
                      {monthLabel(ym)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {sortedMonths.length > 0 && (
            <div class="mt-8 p-4 bg-amber-50 border border-amber-200 rounded-xl">
              <p class="text-xs text-amber-800 leading-relaxed">
                <strong>Note :</strong> Certaines dates de camps sont provisoires et seront confirmées par les sections concernées.
              </p>
            </div>
          )}
        </div>
      </aside>

      <!-- Events by month -->
      <main class="lg:col-span-3 space-y-10">
        {sortedMonths.length === 0 && (
          <div class="bg-white border border-dashed border-gray-200 rounded-xl p-10 text-center">
            <p class="text-gray-600 font-medium">Le calendrier de l'année n'est pas encore publié.</p>
            <p class="text-sm text-gray-500 mt-1">
              Les dates seront ajoutées ici au fur et à mesure qu'elles seront confirmées.
            </p>
          </div>
        )}

        {sortedMonths.map((ym) => (
          <div id={`month-${ym}`}>
            <h2 class="text-xl font-bold text-unit-dark capitalize mb-4 flex items-center gap-3">
              {monthLabel(ym)}
              <span class="h-px flex-1 bg-gray-100"></span>
            </h2>

            <div class="space-y-3">
              {months[ym].sort((a, b) => a.date.localeCompare(b.date)).map((event) => {
                const config = categoryConfig[event.category];
                const isPast = event.date < today;
                return (
                  <div class:list={[
                    "flex gap-4 p-4 rounded-xl border transition-colors",
                    isPast
                      ? "bg-gray-50 border-gray-100 opacity-60"
                      : "bg-white border-gray-100 hover:border-gray-200 hover:shadow-sm"
                  ]}>
                    <!-- Color bar -->
                    <div class={`w-1 rounded-full shrink-0 ${config.bg}`}></div>

                    <!-- Content -->
                    <div class="flex-1 min-w-0">
                      <div class="flex flex-wrap items-start justify-between gap-2">
                        <h3 class="font-semibold text-unit-dark">{event.title}</h3>
                        <div class="flex flex-wrap gap-1.5">
                          <span class={`text-xs px-2 py-0.5 rounded-full font-medium border ${
                            event.category === 'camp' ? 'bg-unit-red/10 text-unit-red border-unit-red/20' :
                            event.category === 'we-unite' ? 'bg-unit-gold/20 text-amber-700 border-unit-gold/30' :
                            'bg-gray-100 text-gray-600 border-gray-200'
                          }`}>
                            {config.label}
                          </span>
                          {event.unit && (
                            <span class="text-xs px-2 py-0.5 rounded-full bg-gray-50 text-gray-500 border border-gray-100">
                              {unitLabel[event.unit]}
                            </span>
                          )}
                        </div>
                      </div>
                      <p class="text-sm text-unit-red font-medium mt-1">
                        {formatRange(event.date, event.endDate)}
                      </p>
                      {event.description && (
                        <p class="text-sm text-gray-500 mt-1 leading-relaxed">{event.description}</p>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </main>
    </div>
  </div>
</PageLayout>
