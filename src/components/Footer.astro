---
const currentYear = new Date().getFullYear();
---

<footer class="bg-unit-dark text-gray-300 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Identité -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <img
            src="/images/logo-stdom.png"
            alt="Logo Saint-Dominique"
            class="h-10 w-10 object-contain opacity-90"
            onerror="this.style.display='none'"
          />
          <div>
            <p class="font-bold text-white text-base">Saint-Dominique</p>
            <p class="text-xs text-gray-400">67ème Guide · 106ème Scout</p>
          </div>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed">
          "Du temps, du talent, et du cœur."<br />
          Parvis Saint-Dominique, Kraainem
        </p>
        <div class="flex gap-3 mt-4">
          <a
            href="https://www.facebook.com/UniteStDom"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href="https://instagram.com/st_dom_67_106"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Navigation</h3>
        <ul class="space-y-2 text-sm">
          {[
            ['/', 'Accueil'],
            ['/unite', "L'Unité"],
            ['/sections', 'Sections'],
            ['/calendrier', 'Calendrier'],
            ['/pratique', 'Pratique'],
            ['/documents', 'Documents'],
          ].map(([href, label]) => (
            <li>
              <a href={href} class="hover:text-white transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Unités -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Unités</h3>
        <div class="space-y-3 text-sm">
          <div>
            <p class="font-medium text-guide-green-light mb-1">67ème Unité Guide</p>
            <p class="text-gray-400">administration67@stdom.be</p>
            <p class="text-gray-400">inscriptions67@stdom.be</p>
          </div>
          <div>
            <p class="font-medium text-gray-300 mb-1">106ème Unité Scoute</p>
            <p class="text-gray-400">administration106@stdom.be</p>
            <p class="text-gray-400">inscriptions106@stdom.be</p>
          </div>
        </div>
      </div>

      <!-- Liens utiles -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Liens utiles</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/asbl" class="hover:text-white transition-colors">ASBL Saint-Dominique</a>
          </li>
          <li>
            <a href="/alumni-clan" class="hover:text-white transition-colors">Alumni & Clan</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white transition-colors">Contact</a>
          </li>
          <li>
            <a
              href="https://lesguides.be"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >Les Guides Catholiques ↗</a>
          </li>
          <li>
            <a
              href="https://lesscouts.be"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >Les Scouts Baden-Powell ↗</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-gray-700 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-gray-500">
      <p>&copy; {currentYear} Unités Saint-Dominique 67-106. Tous droits réservés.</p>
      <p>Fait avec ❤️ par les animateurs de Saint-Dominique</p>
    </div>
  </div>
</footer>
