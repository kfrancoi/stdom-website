---
export interface Props {
  totem: string;
  name: string;
  role?: string;
  phone?: string;
  email?: string;
  photo?: string;
  compact?: boolean;
}

const {
  totem,
  name,
  role,
  phone,
  email,
  photo,
  compact = false,
} = Astro.props;

const initials = name
  .split(' ')
  .filter((w) => w.length > 1)
  .slice(0, 2)
  .map((w) => w[0])
  .join('');
---

{compact ? (
  <!-- Compact version — used in section pages for non-chef staff -->
  <div class="flex items-center gap-3 py-2">
    <div class="w-9 h-9 rounded-full bg-gradient-to-br from-unit-red/20 to-unit-gold/20 flex items-center justify-center shrink-0">
      {photo ? (
        <img src={photo} alt={name} class="w-9 h-9 rounded-full object-cover" loading="lazy" />
      ) : (
        <span class="text-xs font-bold text-unit-red">{initials}</span>
      )}
    </div>
    <div class="min-w-0">
      <p class="text-sm font-semibold text-unit-dark leading-tight">{totem}</p>
      <p class="text-xs text-gray-500 truncate">{name}</p>
    </div>
  </div>
) : (
  <!-- Full version — used in staff/unit pages -->
  <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm text-center">
    <div class="w-16 h-16 rounded-full mx-auto mb-3 overflow-hidden bg-gradient-to-br from-unit-red/10 to-unit-gold/10 flex items-center justify-center">
      {photo ? (
        <img src={photo} alt={name} class="w-full h-full object-cover" loading="lazy" />
      ) : (
        <span class="text-xl font-bold text-unit-red">{initials}</span>
      )}
    </div>
    <p class="font-bold text-unit-dark text-base">{totem}</p>
    <p class="text-sm text-gray-600 mt-0.5">{name}</p>
    {role && <p class="text-xs text-gray-400 mt-1 leading-tight">{role}</p>}
    {(phone || email) && (
      <div class="mt-3 space-y-1">
        {phone && (
          <a
            href={`tel:${phone.replace(/\s/g, '')}`}
            class="flex items-center justify-center gap-1 text-xs text-gray-500 hover:text-unit-red transition-colors"
          >
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {phone}
          </a>
        )}
        {email && (
          <a
            href={`mailto:${email}`}
            class="flex items-center justify-center gap-1 text-xs text-gray-500 hover:text-unit-red transition-colors truncate"
          >
            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="truncate">{email}</span>
          </a>
        )}
      </div>
    )}
  </div>
)}
